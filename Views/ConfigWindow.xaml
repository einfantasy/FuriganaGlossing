<Window x:Class="FuriganaGlossing.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="400" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
             <TextBlock Text="OCR Server URL:" Margin="0,0,0,5"/>
             <TextBox Text="{Binding OcrServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>
             
             <TextBlock Text="Translation Server URL:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding TranslationServerUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

            <TextBlock Text="OCR Start Command:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding OcrStartCommand, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

            <TextBlock Text="LLM Start Command:" Margin="0,0,0,5"/>
            <TextBox Text="{Binding LlmStartCommand, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Start Servers" Command="{Binding StartServersCommand}" Width="100" Margin="0,0,10,0"/>
                <Button Content="Save" Command="{Binding SaveCommand}" Width="80" Margin="0,0,10,0"/>
                <Button Content="Cancel" Click="Cancel_Click" Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
