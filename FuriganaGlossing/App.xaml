<Application x:Class="FuriganaGlossing.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FuriganaGlossing"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
              StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <!-- 颜色 Token (Brush, 用于 Background/Foreground/BorderBrush/Fill) -->
        <SolidColorBrush x:Key="pageBg" Color="#F4F5F7"/>
        <SolidColorBrush x:Key="surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="border" Color="#E3E6EC"/>
        <SolidColorBrush x:Key="borderStrong" Color="#CBD0DA"/>
        <SolidColorBrush x:Key="textPrimary" Color="#16181C"/>
        <SolidColorBrush x:Key="textSecondary" Color="#5C6370"/>
        <SolidColorBrush x:Key="textMuted" Color="#8B93A1"/>
        <SolidColorBrush x:Key="textInvert" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="accent" Color="#4266F2"/>
        <SolidColorBrush x:Key="accentHover" Color="#3750E3"/>
        <SolidColorBrush x:Key="accentPressed" Color="#2C3FD9"/>
        <SolidColorBrush x:Key="accentSoft" Color="#E9EDFF"/>
        <SolidColorBrush x:Key="success" Color="#15803D"/>
        <SolidColorBrush x:Key="warning" Color="#B45309"/>
        <SolidColorBrush x:Key="error" Color="#B91C1C"/>
        <SolidColorBrush x:Key="disabledText" Color="#A0A7B4"/>

        <!-- 字体 Token -->
        <FontFamily x:Key="fontFamilyUI">Segoe UI</FontFamily>
        <FontFamily x:Key="fontFamilyLog">Consolas</FontFamily>
        <sys:Double x:Key="fontSizeTitle">15</sys:Double>
        <sys:Double x:Key="fontSizeBody">13</sys:Double>
        <sys:Double x:Key="fontSizeLabel">13</sys:Double>
        <sys:Double x:Key="fontSizeCaption">12</sys:Double>
        <sys:Double x:Key="fontSizeLog">12</sys:Double>
        <sys:Double x:Key="controlHeight">32</sys:Double>

        <!-- 扁平按钮模板 -->
        <ControlTemplate x:Key="FlatButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
            <Setter Property="Background" Value="{StaticResource accent}"/>
            <Setter Property="Foreground" Value="{StaticResource textInvert}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14 6"/>
            <Setter Property="FontSize" Value="{StaticResource fontSizeBody}"/>
            <Setter Property="FontFamily" Value="{StaticResource fontFamilyUI}"/>
            <Setter Property="Height" Value="{StaticResource controlHeight}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource accentHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource accentPressed}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource borderStrong}"/>
                    <Setter Property="Foreground" Value="{StaticResource disabledText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 次级按钮 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatButtonTemplate}"/>
            <Setter Property="Background" Value="{StaticResource surface}"/>
            <Setter Property="Foreground" Value="{StaticResource textPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource borderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12 6"/>
            <Setter Property="FontSize" Value="{StaticResource fontSizeBody}"/>
            <Setter Property="FontFamily" Value="{StaticResource fontFamilyUI}"/>
            <Setter Property="Height" Value="{StaticResource controlHeight}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource accentSoft}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource pageBg}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource surface}"/>
                    <Setter Property="Foreground" Value="{StaticResource disabledText}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource border}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>